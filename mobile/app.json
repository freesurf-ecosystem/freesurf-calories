{
  "expo": {
    "name": "Calories",
    "slug": "freesurf-calorie-tracker",
    "version": "0.1.2",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "scheme": "freesurf-calorie-tracker",
    "splash": {
      "backgroundColor": "#0b1020"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "android": {
      "package": "tools.freesurf.calorietracker",
      "versionCode": 3
    },
    "ios": {
      "bundleIdentifier": "tools.freesurf.calorietracker",
      "infoPlist": {
        "NSCameraUsageDescription": "FreeSurf Calorie Tracker uses your camera to photograph your meal so it can identify the foods and estimate their nutrition (calories, protein, carbs, and fat). Photos are processed and are not stored.",
        "NSPhotoLibraryUsageDescription": "FreeSurf Calorie Tracker uses your photo library so you can choose an existing meal photo to analyze its nutrition. Photos are processed and are not stored.",
        "NSUserTrackingUsageDescription": "Your device identifier is used to serve personalized ads and keep FreeSurf free.",
        "ITSAppUsesNonExemptEncryption": false
      },
      "privacyManifests": {
        "NSPrivacyAccessedAPITypes": [
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryUserDefaults",
            "NSPrivacyAccessedAPITypeReasons": [
              "CA92.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryFileTimestamp",
            "NSPrivacyAccessedAPITypeReasons": [
              "C617.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryUserDefaults",
            "NSPrivacyAccessedAPITypeReasons": [
              "CA92.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryFileTimestamp",
            "NSPrivacyAccessedAPITypeReasons": [
              "C617.1"
            ]
          }
        ]
      }
    },
    "extra": {
      "eas": {
        "projectId": "b1750bbd-1b59-4310-918e-517d029e31cd"
      }
    },
    "owner": "freesurf",
    "plugins": [
      "expo-image-picker",
      "expo-tracking-transparency",
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 36,
            "targetSdkVersion": 36,
            "buildToolsVersion": "36.0.0",
            "useLegacyPackaging": false
          }
        }
      ],
      "expo-web-browser"
    ]
  }
}
